# 認証情報は Keychain だけを正とする。ここに置くことはない
.env
.env.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# LLM レスポンスキャッシュ（開発時のクレジット節約用。成果物ではない）
.cache/

# 実行ジャーナル（実行ごとに変わる）。
# ディレクトリごと除外すると中の例外指定が効かないので、中身を除外する
runs/*
# ただし測定結果は README で主張の根拠にしているので残す
!runs/compare.json
!runs/attack.json

.DS_Store

# デモ録画の中間生成物（素材とTTSキャッシュ。出力は docs/demo.mp4 に置く）
scripts/demo/output/
scripts/demo/node_modules/

# 登壇資料の中間生成物（原本は deck.html / talk_script.md）
docs/pitch/_slides/
